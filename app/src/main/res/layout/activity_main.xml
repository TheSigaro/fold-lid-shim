<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/tvState" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="28sp" android:layout_weight="1" />
          <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swService" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Служба" android:minHeight="64dp" android:paddingStart="16dp" />
        </LinearLayout>
        <TextView android:id="@+id/tvAngle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginTop="0dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Датчик Холла: пока неясно" android:textSize="16sp" android:layout_marginBottom="8dp" android:id="@+id/tvHall" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Наблюдаем состояние" android:textSize="16sp" android:layout_marginBottom="8dp" android:id="@+id/tvAction" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="14sp" android:textColor="?android:attr/textColorSecondary" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ручное управление" android:textSize="22sp" android:layout_marginBottom="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnForceOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Открыть принудительно" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnForceClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Закрыть принудительно" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Добавьте плитку «Экран Fold» в быстрые настройки. Она снимает запрос закрытия, даже когда угла нет." android:textSize="16sp" android:layout_marginBottom="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnTest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/btn_test_now" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настройки" android:textSize="22sp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/direct_explanation" android:textSize="16sp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tvAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" />
        <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/accessibility_settings" />
        <TextView android:id="@+id/tvDsmStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="18sp" />
        <TextView android:id="@+id/tvOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="18sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_overlay_permission" android:layout_marginTop="0dp" />
        <RadioGroup android:id="@+id/rgSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp">
          <RadioButton android:id="@+id/rbSamsung" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_samsung" />
          <RadioButton android:id="@+id/rbAccel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_accel" />
          <RadioButton android:id="@+id/rbHinge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_hinge" />
        </RadioGroup>
        <EditText android:id="@+id/etClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/hint_close_deg" android:importantForAutofill="no" android:inputType="numberDecimal" />
        <EditText android:id="@+id/etOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hint_open_deg" android:importantForAutofill="no" android:inputType="numberDecimal" android:layout_marginTop="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_save_thresholds" android:layout_marginTop="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_battery" android:layout_marginTop="0dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSensors" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Датчики - раскрыть" />
        <LinearLayout android:id="@+id/sensorDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <TextView android:id="@+id/tvSensor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="18sp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Инверсия осей sub" android:textSize="16sp" android:layout_marginBottom="8dp" />
          <CheckBox android:id="@+id/cbInvertX" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/axis_x" android:layout_marginTop="0dp" />
          <CheckBox android:id="@+id/cbInvertY" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/axis_y" android:layout_marginTop="0dp" />
          <CheckBox android:id="@+id/cbInvertZ" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/axis_z" android:layout_marginTop="0dp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Шторка уведомлений" android:textSize="22sp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Приложение не запрашивает разрешение на уведомления. При отозванном разрешении уведомление службы скрыто из шторки." android:textSize="16sp" android:layout_marginBottom="8dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</ScrollView>
