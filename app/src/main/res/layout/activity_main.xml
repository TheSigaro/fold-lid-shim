<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Mode selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_label"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDirect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_direct" />

            <RadioButton
                android:id="@+id/rbShizuku"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_shizuku" />
        </RadioGroup>

        <!-- Shizuku status (visible only in shizuku mode) -->
        <TextView
            android:id="@+id/tvShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_request_permission" />

        <!-- Overlay permission status -->
        <TextView
            android:id="@+id/tvOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_overlay_permission" />

        <!-- DSM status (visible only in direct mode) -->
        <TextView
            android:id="@+id/tvDsmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="18sp" />

        <!-- Overall status text (test results, errors) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/source_label" android:textSize="18sp" />
        <RadioGroup android:id="@+id/rgSource" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbSamsung" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/source_samsung" />
            <RadioButton android:id="@+id/rbAccel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/source_accel" />
            <RadioButton android:id="@+id/rbHinge" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/source_hinge" />
        </RadioGroup>
        <Switch android:id="@+id/swForceOpened" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/force_opened" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/invert_sub" />
        <CheckBox android:id="@+id/cbInvertX" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/axis_x" />
        <CheckBox android:id="@+id/cbInvertY" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/axis_y" />
        <CheckBox android:id="@+id/cbInvertZ" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/axis_z" />

        <!-- Sensor info -->
        <TextView
            android:id="@+id/tvSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/swService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/switch_service" />

        <EditText
            android:id="@+id/etClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_close_deg"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_open_deg"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_thresholds" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_test_now" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_battery" />
    </LinearLayout>
</ScrollView>
